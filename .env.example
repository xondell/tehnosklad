# Browser-safe. These values are embedded in the frontend bundle.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Production accepts only `supabase`.
# Development/test default to demo when this variable is absent.
CATALOG_DATA_SOURCE=supabase

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only lead abuse protection. Use at least 32 random characters.
LEAD_IP_HASH_SECRET=

# Optional for local development, required for production Telegram delivery.
# A missing/invalid configuration never rolls back a saved lead; it is logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reserved for the AI stage.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
