# Browser-safe. These values are embedded in the frontend bundle.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Production accepts only `supabase`.
# Development/test default to demo when this variable is absent.
CATALOG_DATA_SOURCE=supabase

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for later stages; Stage 3 does not require these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_PROVIDER=
AI_PROVIDER_API_KEY=
